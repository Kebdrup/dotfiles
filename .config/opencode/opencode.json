{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-4.6",
  "small_model": "github-copilot/claude-haiku-4-5",
  "default_agent": "plan",
  "autoupdate": true,
  "share": "manual",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": { "baseURL": "http://127.0.0.1:8087/v1" },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B (local)",
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    },
    "alexandra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Alexandra AI",
      "options": {
        "baseURL": "https://inference.alexandra.dk/v1",
        "apiKey": "{file:./alx-key}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash"
        },
        "qwen3.5-397b": {
          "name": "Qwen 3.5 397B"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "color": "accent"
    },
    "build": {
      "color": "error"
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "write": "allow",
    "fetch": "allow",
    "bash": {
      "*": "ask",
      "git *": "deny"
    }
  }
}
