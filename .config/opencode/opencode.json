{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-4.6",
  "small_model": "github-copilot/claude-haiku-4-5",
  "default_agent": "plan",
  "autoupdate": true,
  "share": "manual",
  "agent": {
    "plan": {
      "color": "accent"
    },
    "build": {
      "color": "error"
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "write": "allow",
    "fetch": "allow",
    "bash": {
      "*": "ask",
      "git *": "deny"
    }
  }
}
