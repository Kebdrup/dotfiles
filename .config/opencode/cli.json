{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "app.exit": "ctrl+c,<leader>q",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "input.delete.to.line.start": "none",
    "input.delete": "delete,shift+delete",
    
    "command.palette.show": "<leader>p",
    "session.tab.next": "ctrl+n",
    "session.tab.previous": "ctrl+p",
    "session.tab.close": ["ctrl+w", "<leader>w"]
  },
  "theme": {
    "name": "vesper-black"
  }
}
