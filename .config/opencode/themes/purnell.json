{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "black": "#000000",
    "white": "#FFFFFF",
    "gray2": "#333333",
    "gray3": "#4D4D4D",
    "grey": "#606060",
    "greyLight": "#b3b3b3",
    "greyBlue": "#85A3B0",
    "blueDark": "#667ea7",
    "blueLight": "#70abaf",
    "orange": "#FF8C00",
    "greyGreen": "#8FA68F",
    "greyRed": "#A68F8F",
    "darkGreyGreen": "#2A3D2A",
    "darkGreyRed": "#3D2A2A",
    "midGreyGreen": "#3A5C3A",
    "midGreyRed": "#5C3A3A"
  },
  "theme": {
    "primary": {
      "dark": "white",
      "light": "white"
    },
    "secondary": {
      "dark": "gray2",
      "light": "gray2"
    },
    "accent": {
      "dark": "greyBlue",
      "light": "greyBlue"
    },
    "error": {
      "dark": "orange",
      "light": "orange"
    },
    "warning": {
      "dark": "orange",
      "light": "orange"
    },
    "success": {
      "dark": "greyGreen",
      "light": "greyGreen"
