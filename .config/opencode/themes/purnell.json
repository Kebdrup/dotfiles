    "syntaxVariable": {
      "dark": "greyLight",
      "light": "greyLight"
    },
    "syntaxString": {
      "dark": "greyBlue",
      "light": "greyBlue"
    },
    "syntaxNumber": {
      "dark": "white",
      "light": "white"
    },
    "syntaxType": {
      "dark": "blueLight",
      "light": "blueLight"
    },
    "syntaxOperator": {
      "dark": "grey",
      "light": "grey"
    },
    "syntaxPunctuation": {
      "dark": "grey",
      "light": "grey"
    }
